# ==========================================================
# Dizital Adda CRM - Server Environment Variables Template
# Copy this file to .env and fill in your actual credentials
# DO NOT COMMIT REAL PASSWORDS OR KEYS TO GITHUB
# ==========================================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL / Neon Database)
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host/your_db_name?sslmode=require
DB_SSL=true
DB_POOL_MAX=5

# JWT Authentication Secrets (Generate strong random strings)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# Web Push (generate a matching key pair with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@dizitaladda.com

# Client / Frontend URL (Leave blank on Vercel for auto-detection)
CLIENT_URL=https://your-crm-domain.vercel.app
# For multiple frontend domains, keep CLIENT_URL as the primary one and list
# any additional exact origins here. Do not use wildcard values.
ALLOWED_ORIGINS=https://your-crm-domain.vercel.app

# Twilio click-to-call and recordings (keep these only in server/deployment secrets)
TELEPHONY_PROVIDER=TWILIO
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_CALLER_ID=your_twilio_voice_number
TELEPHONY_WEBHOOK_URL=https://your-api-domain.com/api/telephony/webhook

# Lead & Employee Sequence Prefixes
EMPLOYEE_CODE_PREFIX=EMP
DEFAULT_EMPLOYEE_PASSWORD=Welcome@1234
# Keep false in production; the admin must set a unique temporary password per employee.
ALLOW_DEFAULT_EMPLOYEE_PASSWORD=false

# Meta (Facebook / Instagram) Lead Ads Webhook
META_VERIFY_TOKEN=your_meta_verify_token_here
META_APP_SECRET=your_meta_app_secret_here
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
META_DEFAULT_DOMAIN=DizitalAdda

# Google Ads Lead Form Webhook
GOOGLE_LEAD_KEY=your_google_lead_key_here
GOOGLE_DEFAULT_DOMAIN=DizitalAdda

# Security: keep staff account creation closed in production unless an invite flow exists.
ALLOW_PUBLIC_REGISTRATION=false
# Comma-separated exact browser origins permitted to call this API (no wildcard domains).
ALLOWED_ORIGINS=https://your-crm-domain.vercel.app
