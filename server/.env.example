# ==========================================================
# Dizital Adda CRM - Server Environment Variables Template
# Copy this file to .env and fill in your actual credentials
# DO NOT COMMIT REAL PASSWORDS OR KEYS TO GITHUB
# ==========================================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL / Neon Database)
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host/your_db_name?sslmode=require
DB_SSL=true
DB_POOL_MAX=5

# JWT Authentication Secrets (Generate strong random strings)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# Client / Frontend URL (Leave blank on Vercel for auto-detection)
CLIENT_URL=https://your-crm-domain.vercel.app

# Lead & Employee Sequence Prefixes
EMPLOYEE_CODE_PREFIX=EMP
DEFAULT_EMPLOYEE_PASSWORD=Welcome@1234

# Meta (Facebook / Instagram) Lead Ads Webhook
META_VERIFY_TOKEN=your_meta_verify_token_here
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
META_DEFAULT_DOMAIN=DizitalAdda

# Google Ads Lead Form Webhook
GOOGLE_LEAD_KEY=your_google_lead_key_here
GOOGLE_DEFAULT_DOMAIN=DizitalAdda
