# Use a database dedicated exclusively to automated tests. Its name must end in _test.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dizitaladda_crm_test
DB_SSL=false
JWT_SECRET=test-access-secret-change-me
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=test-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d
NODE_ENV=test
LOG_LEVEL=error
