# ==========================================================
# Comprehensive GitIgnore for Dizital Adda CRM
# Protects sensitive environment credentials, logs, & builds
# ==========================================================

# 1. Environment & Secrets (NEVER COMMIT TO PUBLIC REPO)
.env
.env.*
*.env
*.env.local
*.env.development
*.env.test
*.env.production
server/.env
frontend/.env
frontend/.env.*
api/.env

# Whitelist safe example templates
!.env.example
!*.env.example
!server/.env.example
!frontend/.env.example

# 2. Dependencies
node_modules/
*/node_modules/

# 3. Build & Distribution Folders
dist/
*/dist/
build/
*/build/
.output/

# 4. Logs & Debug Files
logs/
*/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 5. Vercel & Cloud deployment metadata
.vercel/

# 6. Operating System & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
